    {
      "name": "Casos",
      "item": [
        {
          "name": "GET /casos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/casos?page=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["casos"],
              "query": [
                { "key": "page",  "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET /casos/:id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/casos/{{caso_id}}"
          }
        },
        {
          "name": "POST /casos",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/casos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oficial_administrador_id\": \"{{oficial_id}}\",\n  \"agentes_asignados\": [],\n  \"desaparecido\": {\n    \"nombre\": \"María García\",\n    \"descripcion\": \"Cabello castaño, ojos marrones, 1.60m\",\n    \"edad\": 28,\n    \"imagen\": \"https://bucket.url/foto.jpg\",\n    \"ultima_ubicacion_oficial\": {\n      \"type\": \"Point\",\n      \"coordinates\": [-58.3816, -34.6037]\n    }\n  },\n  \"representante_externo\": {\n    \"nombre\": \"Carlos García\",\n    \"email\": \"carlos@mail.com\",\n    \"telefono\": \"1122334455\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "PATCH /casos/:id/estado",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/casos/{{caso_id}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"resuelto\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "POST /casos/:id/agentes/:agenteId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/casos/{{caso_id}}/agentes/{{agente_id}}"
          }
        },
        {
          "name": "DELETE /casos/:id/agentes/:agenteId",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/casos/{{caso_id}}/agentes/{{agente_id}}"
          }
        }
